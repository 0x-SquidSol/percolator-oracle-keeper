{
  "name": "percolator-oracle-keeper",
  "version": "1.0.0",
  "description": "Oracle keeper service for Percolator — mirrors price feeds to Percolator devnet markets via PushOraclePrice + KeeperCrank",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cross-cluster.ts",
    "dev": "tsx watch src/cross-cluster.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"src/**/*.test.ts\"",
    "cross-cluster": "tsx src/cross-cluster.ts",
    "cross-cluster:dry-run": "tsx src/dry-run.ts",
    "cross-cluster:live": "tsx src/cross-cluster.ts",
    "pre-resolve": "tsx src/pre-resolve-drain.ts",
    "rotate-logs": "bash scripts/rotate-keeper-logs.sh"
  },
  "dependencies": {
    "@percolatorct/sdk": "github:dcccrypto/percolator-sdk#a18c199ee8285b6f5183ed643bb993b49a8ebf75",
    "@solana/web3.js": "1.99.0",
    "@supabase/supabase-js": "^2.111.0",
    "tsx": "4.19.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
