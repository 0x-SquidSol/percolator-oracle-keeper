{
  "name": "percolator-oracle-keeper",
  "version": "1.0.0",
  "description": "Oracle keeper service for Percolator \u2014 mirrors price feeds to Percolator devnet markets via PushOraclePrice + KeeperCrank",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cross-cluster.ts",
    "dev": "tsx watch src/cross-cluster.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"src/**/*.test.ts\"",
    "cross-cluster": "tsx src/cross-cluster.ts",
    "cross-cluster:dry-run": "tsx src/dry-run.ts",
    "cross-cluster:live": "tsx src/cross-cluster.ts",
    "pre-resolve": "tsx src/pre-resolve-drain.ts",
    "rotate-logs": "bash scripts/rotate-keeper-logs.sh"
  },
  "dependencies": {
    "@percolatorct/sdk": "github:dcccrypto/percolator-sdk#3a435f004ea66ca1a68e93c36d7ccefb2bd4ba28",
    "@solana/web3.js": "1.99.0",
    "@supabase/supabase-js": "^2.111.0",
    "tsx": "4.19.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "ws@>=7.0.0 <7.5.11": "7.5.13",
    "ws@>=8.0.0 <8.20.2": "8.22.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=7.0.0 <7.5.11": "7.5.13",
      "ws@>=8.0.0 <8.20.2": "8.22.0"
    }
  }
}
